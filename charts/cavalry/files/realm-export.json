{
  "realm": "ev-network",
  "enabled": true,
  "clients": [
    {
      "clientId": "ev-frontend",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "publicClient": false,
      "redirectUris": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "ADMIN" },
      { "name": "CUSTOMER" }
    ]
  },
  "users": [
    {
      "username": "admin_user",
      "email": "admin@ev.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [ "ADMIN" ]
    },
    {
      "username": "customer_user",
      "email": "customer@ev.com",
      "enabled": true,
      "firstName": "Customer",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "customer123",
          "temporary": false
        }
      ],
      "realmRoles": [ "CUSTOMER" ]
    }
  ]
}
